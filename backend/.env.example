# Copy to .env and fill in.

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000
# CORS: your deployed frontend origin(s) — REQUIRED in production or the browser
# blocks scan requests (shows "Network Error"). Exact scheme+host, no trailing
# slash. Comma-separate multiple origins. e.g. https://your-frontend.vercel.app
FRONTEND_URL=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-xxxxx
# Optional: override the model fallback chain (comma-separated)
OPENROUTER_MODELS=anthropic/claude-3.5-haiku,openai/gpt-4o,openai/gpt-4o-mini
# Optional: per-model upstream request timeout in ms (default 25000)
OPENROUTER_TIMEOUT_MS=25000

# Supabase (Project Settings → API).
# The Express backend operates under each user's JWT (RLS), so it only needs the
# URL + anon key. SUPABASE_SERVICE_ROLE_KEY is NOT read by the backend — it is
# used only by the Supabase edge functions (injected there automatically).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key

LOG_LEVEL=info
