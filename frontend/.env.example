# Copy to .env.local and fill in. See /supabase/README.md.

# Public API base (backend) — used in later phases for scan endpoints.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# UPI payments (phase 3). The VPA is where users pay to upgrade; the upgrade page
# shows a QR + this UPI ID. Without NEXT_PUBLIC_UPI_VPA the upgrade flow shows a
# "payments not configured" message.
NEXT_PUBLIC_UPI_VPA=yourname@okaxis
NEXT_PUBLIC_UPI_PAYEE=Neural Shield AI
