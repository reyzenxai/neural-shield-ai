# n8n self-hosted config. Copy to .env next to docker-compose.yml and fill in.

# The public HTTPS host that points at this n8n (e.g. a Cloudflare Tunnel hostname).
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourdomain.com/

GENERIC_TIMEZONE=Asia/Kolkata

# Encrypts saved credentials. Generate once and keep it stable:
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace-with-a-random-secret
