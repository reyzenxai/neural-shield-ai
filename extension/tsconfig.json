{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  "include": ["src/**/*.ts", "popup/**/*.ts", "options/**/*.ts", "background/**/*.ts", "content/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
